      <column caption='AVG YTD Car sold' datatype='real' default-format='c&quot;$&quot;#,##0,.0K' name='[Calculation_876794584093151241]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF &#13;&#10;YEAR([Date])={MAX(YEAR([Date]))}&#13;&#10;THEN&#13;&#10;[Price ($)]&#13;&#10;END)' />
